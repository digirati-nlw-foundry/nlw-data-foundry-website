---
import { LOCALES } from "../../../../lib/i18n";
import { iiif } from "../../../../lib/iiif.server";
export async function getStaticPaths() {
  const paths=await iiif.getCollectionStaticPaths({props:true});
  return LOCALES.flatMap(locale=>paths.map(path=>({...path,params:{locale,...path.params}})));
}
const slug=Astro.props.slug as string;
return Astro.redirect(`/${Astro.params.locale}/iiif/resources/${slug.split("/").map(encodeURIComponent).join("/")}/`);
---
