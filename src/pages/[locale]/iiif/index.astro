---
import Layout from "../../../layouts/Layout.astro";
import { LOCALES, type Locale } from "../../../lib/i18n";
import { iiifLabel, iiifStoreId, type IiifSnippet } from "../../../lib/iiif-navigation";
import { iiif } from "../../../lib/iiif.server";
export function getStaticPaths() {return LOCALES.map(locale=>({params:{locale}}));}
const locale=Astro.params.locale as Locale;
const title=locale==="cy"?"Setiau data IIIF":"IIIF datasets";
const stores=await iiif.getAllStoreCollections();
---
<Layout locale={locale} title={title} description="" pageType="homepage" section="data">
  <main class="site-width py-12">
    <h1 class="mb-8 text-3xl font-semibold">{title}</h1>
    <ul class="grid grid-cols-1 gap-4 sm:grid-cols-2 lg:grid-cols-3">
      {(stores.items||[]).map((store:IiifSnippet)=>{
        const id=iiifStoreId(store);return id?<li class="rounded-lg border p-5"><a class="text-lg font-semibold underline" href={`/${locale}/iiif/stores/${encodeURIComponent(id)}/`}>{iiifLabel(store.label,locale,id)}</a><p class="mt-2 text-sm text-gray-500">{store["hss:totalItems"]||0} {locale==="cy"?"adnoddau":"resources"}</p></li>:null;
      })}
    </ul>
    {!(stores.items||[]).length?<p>{locale==="cy"?"Dim adnoddau IIIF wedi'u cyhoeddi eto.":"No IIIF resources have been published yet."}</p>:null}
  </main>
</Layout>
