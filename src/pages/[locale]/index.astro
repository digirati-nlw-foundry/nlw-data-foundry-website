---
import { getCollection } from "astro:content";
import ListingCard from "../../components/ListingCard.astro";
import SearchForm from "../../components/SearchForm.astro";
import Layout from "../../layouts/Layout.astro";
import { getDataCards } from "../../lib/data-cards";
import { getLocalizedString, LOCALES, type Locale } from "../../lib/i18n";
import { homeCopy } from "../../lib/site";

export function getStaticPaths() {
  return LOCALES.map((locale) => ({
    params: { locale },
  }));
}

const locale = Astro.params.locale as Locale;
const dataCards = await getDataCards();
const exhibitions = await getCollection("exhibitions");

const featuredDatasets = dataCards
  .filter((entry) => entry.featured)
  .sort(
    (left, right) => (left.featuredOrder ?? 99) - (right.featuredOrder ?? 99),
  )
  .slice(0, 3);

const homepageDatasets =
  featuredDatasets.length > 0 ? featuredDatasets : dataCards.slice(0, 3);

const featuredExhibitions = exhibitions
  .filter((entry) => entry.data.featured)
  .sort(
    (left, right) =>
      (left.data.featuredOrder ?? 99) - (right.data.featuredOrder ?? 99),
  )
  .slice(0, 3);

const title = getLocalizedString(homeCopy.title, locale);
const description = getLocalizedString(homeCopy.summary, locale);
---

<Layout locale={locale} title={title} description={description} pageType="homepage" section="home" bleed>
  <section class="relative flex min-h-[26rem] items-center justify-center bg-[url('/catalogue_search.jpg')] bg-cover bg-center px-4 py-12 sm:px-6">
    <div class="absolute inset-0 bg-slate-950/40" aria-hidden="true"></div>

    <div class="relative z-10 w-full max-w-2xl rounded-md bg-white p-6 shadow-2xl sm:p-8">
      <h1 class="mb-5 text-center text-2xl font-bold text-balance sm:text-3xl">{getLocalizedString(homeCopy.searchLabel, locale)}</h1>
      <SearchForm locale={locale} variant="hero" />
    </div>
  </section>

  <div class="site-width">
    <section class="flex flex-col gap-6 py-12">
      <div class="flex flex-wrap items-center justify-between gap-x-6 gap-y-3">
        <h2 class="text-2xl font-bold">{getLocalizedString(homeCopy.featuredDatasets, locale)}</h2>
        <a class="btn-secondary" href={`/${locale}/data`}>
          {locale === "en" ? "Browse all data" : "Pori'r holl ddata"}
        </a>
      </div>
      <div class="grid grid-cols-1 gap-6 sm:grid-cols-2 lg:grid-cols-3">
        {
          homepageDatasets.map((entry) => (
            <ListingCard
              locale={locale}
              href={`/${locale}/data/${entry.slug}`}
              title={entry.title}
              summary={entry.description ?? entry.title}
              eyebrow={{ en: "Dataset", cy: "Set ddata" }}
              accent={entry.accent}
              tags={entry.tags}
            />
          ))
        }
      </div>
    </section>

    {
      featuredExhibitions.length > 0 && (
        <section class="flex flex-col gap-6 border-t border-slate-200 py-12">
          <div class="flex flex-wrap items-center justify-between gap-x-6 gap-y-3">
            <h2 class="text-2xl font-bold">{getLocalizedString(homeCopy.featuredExhibitions, locale)}</h2>
            <a class="btn-secondary" href={`/${locale}/exhibitions`}>
              {locale === "en" ? "Browse all exhibitions" : "Pori'r holl arddangosfeydd"}
            </a>
          </div>
          <div class="grid grid-cols-1 gap-6 sm:grid-cols-2 lg:grid-cols-3">
            {featuredExhibitions.map((entry) => (
              <ListingCard
                locale={locale}
                href={`/${locale}/exhibitions/${entry.id}`}
                title={entry.data.title}
                summary={entry.data.summary}
                eyebrow={{ en: "Exhibition", cy: "Arddangosfa" }}
                accent={entry.data.accent}
                tags={entry.data.tags}
              />
            ))}
          </div>
        </section>
      )
    }
  </div>
</Layout>
