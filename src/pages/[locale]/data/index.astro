---
import ListingCard from "../../../components/ListingCard.astro";
import PageHero from "../../../components/PageHero.astro";
import SearchForm from "../../../components/SearchForm.astro";
import Layout from "../../../layouts/Layout.astro";
import { getDataCards } from "../../../lib/data-cards";
import { getLocalizedString, LOCALES, type Locale } from "../../../lib/i18n";

export function getStaticPaths() {
  return LOCALES.map((locale) => ({
    params: { locale },
  }));
}

const locale = Astro.params.locale as Locale;
const entries = await getDataCards();
const allTags = Array.from(
  new Set(
    entries.flatMap((entry) =>
      entry.tags.map((tag) => getLocalizedString(tag, locale)),
    ),
  ),
).sort((left, right) => left.localeCompare(right));
---

<Layout
  locale={locale}
  title={locale === "en" ? "Browse all data" : "Pori'r holl ddata"}
  description={
    locale === "en"
      ? "Explore dataset cards with structured metadata, access details, and reuse guidance."
      : "Archwiliwch gardiau setiau data gyda metadata strwythuredig, manylion mynediad, a chanllawiau ailddefnyddio."
  }
  pageType="page"
  section="data"
  tags={allTags}
  bleed
>
  <PageHero
    eyebrow={locale === "en" ? "Data collections" : "Casgliadau data"}
    heading={locale === "en" ? "Browse all data" : "Pori'r holl ddata"}
    summary={locale === "en"
      ? "Each data card combines lightweight metadata with a fuller editorial markdown record in English and Welsh."
      : "Mae pob cerdyn data yn cyfuno metadata ysgafn â chofnod golygyddol markdown llawnach yn Saesneg ac yn Gymraeg."}
  >
    <div class="mt-8 max-w-2xl">
      <SearchForm locale={locale} />
    </div>
  </PageHero>

  <div class="site-width py-12">
    <section class="mb-10" aria-labelledby="browse-by-tag">
      <h2 class="eyebrow mb-3" id="browse-by-tag">{locale === "en" ? "Browse by tag" : "Pori yn ôl tag"}</h2>
      <ul class="flex flex-wrap gap-2">
        {allTags.map((tag) => (
          <li>
            <a
              class="inline-block rounded-full border border-slate-300 bg-white px-3 py-1 text-sm font-medium text-slate-700 transition-colors hover:border-brand hover:text-brand"
              href={`/${locale}/search?tag=${encodeURIComponent(tag)}`}
            >{tag}</a>
          </li>
        ))}
      </ul>
    </section>

    <section aria-label={locale === "en" ? "Datasets" : "Setiau data"}>
      <div class="grid grid-cols-1 gap-6 sm:grid-cols-2 lg:grid-cols-3">
        {
          entries.map((entry) => (
            <ListingCard
              locale={locale}
              href={`/${locale}/data/${entry.slug}`}
              title={entry.title}
              summary={entry.description ?? entry.title}
              eyebrow={{ en: "Dataset", cy: "Set ddata" }}
              accent={entry.accent}
              tags={entry.tags}
            />
          ))
        }
      </div>
    </section>
  </div>
</Layout>
