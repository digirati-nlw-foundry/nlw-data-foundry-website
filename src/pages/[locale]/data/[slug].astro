---
import { render } from "astro:content";
import { iiif } from "../../../lib/iiif.server";
import DatasetHero from "../../../components/DatasetHero.astro";
import DatasetSidebar from "../../../components/DatasetSidebar.astro";
import { proseComponents } from "../../../components/markdown/mdx";
import Layout from "../../../layouts/Layout.astro";
import { bindDatasetBlocks } from "../../../lib/dataset-blocks";
import { getDataCards, type SiteDataCard } from "../../../lib/data-cards";
import { getLocalizedString, LOCALES, type Locale } from "../../../lib/i18n";

export async function getStaticPaths() {
  const dataCards = await getDataCards();

  return LOCALES.flatMap((locale) =>
    dataCards.map((card) => ({
      params: { locale, slug: card.slug },
      props: { card, locale },
    })),
  );
}

const { card, locale } = Astro.props as {
  card: SiteDataCard;
  locale: Locale;
};

const entry = card.entries[locale] ?? card.entries.en;
const { Content } = await render(entry);
// The hero owns the page's <h1>; demote any `# Title` in the card body.
const components = {
  ...proseComponents,
  ...bindDatasetBlocks(entry.data, locale),
  h1: "h2",
};
const title = getLocalizedString(card.title, locale);
const description = getLocalizedString(card.description, locale);
const tagLabels = card.tags.map((tag) => getLocalizedString(tag, locale));
const institutionLabels = card.institutions.map((institution) =>
  getLocalizedString(institution, locale),
);
const hasBody = (entry.body || "").trim().length > 0;
const datasetIdentifier = card.datasetId;
const accent = card.accent ?? "var(--default-accent)";
const iiifCollection = await iiif.getStoreCollection(card.datasetId);
const iiifCount = iiifCollection?.items?.length || 0;
const hasFiles = card.files.active.length > 0 || card.files.archived.length > 0;
---

<Layout locale={locale} title={title} description={description} pageType="dataset" section="data" tags={tagLabels} bleed>
  <DatasetHero
    locale={locale}
    title={title}
    description={description}
    datasetIdentifier={datasetIdentifier}
    tagLabels={tagLabels}
    accent={accent}
  />

  <div
    class="site-width grid grid-cols-1 gap-x-12 gap-y-10 py-10 sm:py-12 lg:grid-cols-[minmax(0,1fr)_20rem]"
    style={`--accent: ${accent}; --dsb-accent: ${accent};`}
  >
    <div class="min-w-0 max-w-3xl">
      {hasBody ? (
        <div class="prose prose-nlw max-w-none">
          <Content components={components} />
        </div>
      ) : (
        <p class="rounded-md border border-dashed border-slate-300 px-6 py-12 text-center text-sm text-slate-600">
          {locale === "en" ? "No additional content yet." : "Dim cynnwys ychwanegol eto."}
        </p>
      )}

      {iiifCount > 0 && (
        <section class="mt-12 rounded-md border border-slate-200 p-6">
          <h2 class="mb-2 text-xl font-bold">IIIF</h2>
          <a class="font-medium text-(--accent) underline underline-offset-4" href={`/${locale}/iiif/stores/${encodeURIComponent(card.datasetId)}/`}>
            {locale === "cy" ? `Pori ${iiifCount} o adnoddau IIIF` : `Browse ${iiifCount} IIIF resources`}
          </a>
        </section>
      )}
    </div>

    <DatasetSidebar
      locale={locale}
      tagLabels={tagLabels}
      datasetIdentifier={datasetIdentifier}
      institutionLabels={institutionLabels}
      accent={accent}
      team={card.team}
      rights={card.rights}
      license={card.license}
      updated={card.updated}
      ingestedAt={card.ingestedAt}
      files={hasFiles ? card.files : undefined}
    />
  </div>
</Layout>
