---
import type { Locale } from "../lib/i18n";

interface Props {
  locale: Locale;
  title: string;
  description: string;
  datasetIdentifier?: string;
  tagLabels: string[];
  accent: string;
}

const { locale, title, description, datasetIdentifier, tagLabels, accent } =
  Astro.props;
---

<section
  class="border-b border-slate-200 bg-slate-50 py-10 sm:py-12"
  style={`--accent: ${accent};`}
>
  <div class="site-width">
    <a
      href={`/${locale}/data`}
      class="mb-6 inline-flex items-center gap-1.5 text-sm font-semibold text-(--accent) hover:underline"
    >
      <svg
        xmlns="http://www.w3.org/2000/svg"
        class="size-4"
        viewBox="0 0 24 24"
        fill="none"
        stroke="currentColor"
        stroke-width="2"
        stroke-linecap="round"
        stroke-linejoin="round"
        aria-hidden="true"
      >
        <polyline points="15 18 9 12 15 6" />
      </svg>
      {locale === "en" ? "Back to data" : "Yn ôl i'r data"}
    </a>

    <div class="mb-5 h-1 w-12 rounded-full bg-(--accent)" aria-hidden="true"></div>

    {
      datasetIdentifier && (
        <p class="mb-3 font-mono text-xs font-medium tracking-wide text-slate-600">
          {datasetIdentifier}
        </p>
      )
    }

    <h1 class="max-w-4xl text-3xl font-bold leading-tight text-balance text-slate-900 sm:text-4xl">{title}</h1>

    {
      description && (
        <p class="mt-4 max-w-3xl text-lg leading-relaxed text-slate-700">
          {description}
        </p>
      )
    }

    {
      tagLabels.length > 0 && (
        <ul
          class="mt-6 flex flex-wrap gap-2"
          aria-label={locale === "en" ? "Tags" : "Tagiau"}
        >
          {tagLabels.map((tag) => (
            <li>
              <a
                href={`/${locale}/search?tag=${encodeURIComponent(tag)}`}
                class="inline-block rounded-full bg-(--accent)/10 px-3 py-1 text-sm font-semibold text-(--accent) transition-colors hover:bg-(--accent)/20"
              >
                {tag}
              </a>
            </li>
          ))}
        </ul>
      )
    }
  </div>
</section>
