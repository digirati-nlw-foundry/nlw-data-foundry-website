---
interface Props {
  eyebrow?: string;
  heading: string;
  summary?: string;
  backHref?: string;
  backLabel?: string;
  compact?: boolean;
}

const { eyebrow, heading, summary, backHref, backLabel, compact = false } =
  Astro.props;
---

<section class:list={["bg-slate-800 text-white", compact ? "py-10" : "py-12 sm:py-16"]}>
  <div class="site-width">
    {backHref && (
      <a href={backHref} class="mb-6 inline-flex items-center gap-1.5 text-sm text-slate-300 hover:text-white">
        <svg xmlns="http://www.w3.org/2000/svg" class="size-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
          <polyline points="15 18 9 12 15 6" />
        </svg>
        {backLabel}
      </a>
    )}
    {eyebrow && <p class="eyebrow mb-3 !text-slate-300">{eyebrow}</p>}
    <h1 class="max-w-3xl text-3xl font-bold leading-tight text-balance sm:text-4xl">{heading}</h1>
    {summary && <p class="mt-4 max-w-3xl text-lg leading-relaxed text-slate-200">{summary}</p>}
    <slot />
  </div>
</section>
