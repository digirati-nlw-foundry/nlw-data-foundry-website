---
import type { Locale, LocalizedString } from "../lib/i18n";
import { getLocalizedString } from "../lib/i18n";

interface Props {
  locale: Locale;
  href: string;
  title: LocalizedString;
  summary: LocalizedString;
  eyebrow?: LocalizedString;
  accent?: string;
  tags?: LocalizedString[];
}

const {
  locale,
  href,
  title,
  summary,
  eyebrow,
  accent = "var(--default-accent)",
  tags = [],
} = Astro.props;
---

<article
  class="group relative flex flex-col rounded-md border border-slate-200 border-t-4 border-t-(--accent) bg-white p-6 transition-shadow hover:shadow-md"
  style={`--accent:${accent};`}
>
  {eyebrow && <p class="eyebrow mb-2">{getLocalizedString(eyebrow, locale)}</p>}
  <div class="flex-1">
    <h3 class="mb-2 text-xl font-bold leading-snug text-balance text-(--accent)">
      <a class="after:absolute after:inset-0 group-hover:underline" href={href}>{getLocalizedString(title, locale)}</a>
    </h3>
    <p class="mb-5 line-clamp-4 text-base leading-relaxed text-slate-700">{getLocalizedString(summary, locale)}</p>
  </div>

  {
    tags.length > 0 && (
      <ul class="mb-5 flex flex-wrap gap-2" aria-label={locale === "en" ? "Tags" : "Tagiau"}>
        {tags.map((tag) => (
          <li class="rounded-full bg-(--accent)/10 px-2.5 py-0.5 text-xs font-semibold text-(--accent)">{getLocalizedString(tag, locale)}</li>
        ))}
      </ul>
    )
  }

  <p class="inline-flex items-center gap-1.5 text-sm font-semibold text-(--accent)" aria-hidden="true">
    {locale === "en" ? "Read more" : "Darllen mwy"}
    <svg xmlns="http://www.w3.org/2000/svg" class="size-4 transition-transform group-hover:translate-x-0.5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M5 12h14M13 6l6 6-6 6" /></svg>
  </p>
</article>
