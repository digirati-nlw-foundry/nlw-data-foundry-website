---
interface Props {
  eyebrow?: string;
  eyebrowColor?: string;
  heading: string;
  subtext?: string;
  level?: 1 | 2;
}

const { eyebrow, eyebrowColor, heading, subtext, level = 2 } = Astro.props;
---

<div>
  {eyebrow && <p class:list={["eyebrow mb-2", eyebrowColor]}>{eyebrow}</p>}
  {level === 1
    ? <h1 class="mb-3 text-3xl font-bold text-balance sm:text-4xl">{heading}</h1>
    : <h2 class="mb-3 text-2xl font-bold text-balance">{heading}</h2>
  }
  {subtext && <p class="max-w-2xl text-lg text-slate-600">{subtext}</p>}
</div>
