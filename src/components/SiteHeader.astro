---
import { Icon } from "astro-icon/components";
import type { Locale } from "../lib/i18n";
import {
  buildLocalizedPath,
  getLocalizedString,
  swapLocalePath,
} from "../lib/i18n";
import { localeNames, navItems } from "../lib/site";

interface Props {
  locale: Locale;
  currentPath: string;
}

const { locale, currentPath } = Astro.props;
const alternateLocale = locale === "en" ? "cy" : "en";
const alternateHref = swapLocalePath(currentPath, alternateLocale);
---

<header class="relative z-20 border-b border-slate-200 bg-white" data-pagefind-ignore>
  <div class="site-width">

    <!-- Top bar: logo + utility controls -->
    <div class="flex h-16 items-center justify-between gap-4">
      <a class="flex min-w-0 shrink items-center rounded-sm" href={buildLocalizedPath(locale)} aria-label={locale === "en" ? "National Library of Wales, home" : "Llyfrgell Genedlaethol Cymru, hafan"}>
        <img
          src="/llgc_logo.png"
          alt={locale === "en" ? "National Library of Wales" : "Llyfrgell Genedlaethol Cymru"}
          class="h-7 w-auto max-w-full sm:h-10"
        />
      </a>

      <div class="flex shrink-0 items-center gap-2 sm:gap-3">
        <!-- Language switcher — always visible -->
        <a
          class="btn-secondary px-3 py-1.5"
          href={alternateHref}
          hreflang={alternateLocale}
          lang={alternateLocale}
        >
          {getLocalizedString(localeNames[alternateLocale], locale)}
        </a>

        <!-- Search button — always visible -->
        <a
          class="hidden size-9 items-center justify-center rounded-full bg-brand text-white transition-colors hover:bg-brand-hover sm:flex"
          href={buildLocalizedPath(locale, "search")}
          aria-label={locale === "en" ? "Search" : "Chwilio"}
        >
          <Icon name="mdi:magnify" class="w-5 h-5" />
        </a>

        <!-- Hamburger — mobile only -->
        <button
          type="button"
          class="flex size-9 items-center justify-center rounded-sm text-slate-700 transition-colors hover:bg-slate-100 lg:hidden"
          aria-expanded="false"
          aria-controls="mobile-nav"
          aria-label={locale === "en" ? "Open menu" : "Agor y ddewislen"}
          data-menu-toggle
        >
          <Icon name="mdi:menu" class="w-6 h-6" data-icon-open />
          <Icon name="mdi:close" class="w-6 h-6 hidden" data-icon-close />
        </button>
      </div>
    </div>

    <!-- Desktop nav — hidden below lg -->
    <nav
      class="-mx-3 hidden lg:flex"
      aria-label={locale === "en" ? "Primary" : "Prif lywio"}
    >
      {
        navItems.map((item) => {
          const href = buildLocalizedPath(locale, item.slug);
          const active =
            item.slug === ""
              ? currentPath === buildLocalizedPath(locale)
              : currentPath.startsWith(href);

          return (
            <a
              href={href}
              aria-current={active ? "page" : undefined}
              class:list={[
                "-mb-px border-b-2 px-3 py-3 text-sm whitespace-nowrap transition-colors",
                active
                  ? "border-brand font-bold text-brand"
                  : "border-transparent font-medium text-slate-700 hover:border-slate-300 hover:text-brand",
              ]}
            >
              {getLocalizedString(item.label, locale)}
            </a>
          );
        })
      }
    </nav>

  </div>

  <!-- Mobile nav drawer — toggled by JS -->
  <nav
    id="mobile-nav"
    class="hidden border-t border-slate-200 bg-white lg:hidden"
    aria-label={locale === "en" ? "Primary" : "Prif lywio"}
  >
    <ul class="site-width flex flex-col divide-y divide-slate-100 py-2">
      {
        navItems.map((item) => {
          const href = buildLocalizedPath(locale, item.slug);
          const active =
            item.slug === ""
              ? currentPath === buildLocalizedPath(locale)
              : currentPath.startsWith(href);

          return (
            <li>
              <a
                href={href}
                aria-current={active ? "page" : undefined}
                class:list={[
                  "flex items-center py-3 text-base transition-colors",
                  active
                    ? "font-bold text-brand"
                    : "font-medium text-slate-700 hover:text-brand",
                ]}
              >
                {getLocalizedString(item.label, locale)}
              </a>
            </li>
          );
        })
      }
    </ul>
  </nav>
</header>

<script>
  const toggle = document.querySelector("[data-menu-toggle]");
  const mobileNav = document.getElementById("mobile-nav");
  const iconOpen = toggle?.querySelector("[data-icon-open]");
  const iconClose = toggle?.querySelector("[data-icon-close]");

  toggle?.addEventListener("click", () => {
    const isOpen = toggle.getAttribute("aria-expanded") === "true";
    const next = !isOpen;

    toggle.setAttribute("aria-expanded", String(next));
    mobileNav?.classList.toggle("hidden", !next);
    iconOpen?.classList.toggle("hidden", next);
    iconClose?.classList.toggle("hidden", !next);
  });

  // Close the drawer if the viewport grows past the lg breakpoint
  window.matchMedia("(min-width: 1024px)").addEventListener("change", (e) => {
    if (e.matches) {
      toggle?.setAttribute("aria-expanded", "false");
      mobileNav?.classList.add("hidden");
      iconOpen?.classList.remove("hidden");
      iconClose?.classList.add("hidden");
    }
  });
</script>
