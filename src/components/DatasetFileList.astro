---
import type { SiteDataCardFile, SiteDataCardFileGroup } from "../lib/data-cards";
import { contentTypeLabel, formatBytes } from "../lib/file-utils";
import type { Locale } from "../lib/i18n";

interface Props {
  locale: Locale;
  files: {
    active: SiteDataCardFileGroup[];
    archived: SiteDataCardFileGroup[];
  };
}

const { locale, files } = Astro.props;
const en = locale === "en";

const archivedCount = files.archived.reduce((n, g) => n + g.files.length, 0);

const meta = (file: SiteDataCardFile) =>
  [
    contentTypeLabel(file.contentType),
    typeof file.fileSizeBytes === "number" ? formatBytes(file.fileSizeBytes) : "",
  ]
    .filter(Boolean)
    .join(" · ");
---

{
  (files.active.length > 0 || archivedCount > 0) && (
    <section class="rounded-md border border-slate-200 bg-white p-6" aria-labelledby="downloads-heading">
      <h2 class="eyebrow mb-4" id="downloads-heading">{en ? "Downloads" : "Lawrlwythiadau"}</h2>

      {files.active.map((group) => (
        <div class="[&:not(:first-of-type)]:mt-5">
          <p class="mb-1 text-xs font-bold uppercase tracking-wider text-slate-600">
            {en ? `Version ${group.version}` : `Fersiwn ${group.version}`}
            <span class="ml-1 font-semibold normal-case tracking-normal text-emerald-800">· {en ? "current" : "cyfredol"}</span>
          </p>
          <ul class="divide-y divide-slate-200">
            {group.files.map((file) => (
              <li class="flex items-center gap-3 py-3">
                <div class="min-w-0 flex-1">
                  <p class="truncate text-sm font-semibold text-slate-900" title={file.fileName}>{file.fileName}</p>
                  <p class="text-xs text-slate-600">{meta(file)}</p>
                </div>
                {file.apiLink && (
                  <a
                    href={file.apiLink}
                    class="flex size-9 shrink-0 items-center justify-center rounded-sm border border-(--accent) text-(--accent) transition-colors hover:bg-(--accent) hover:text-white"
                    aria-label={`${en ? "Download" : "Lawrlwytho"} ${file.fileName}`}
                    title={en ? "Download" : "Lawrlwytho"}
                  >
                    <svg xmlns="http://www.w3.org/2000/svg" class="size-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.25" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                      <path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4" />
                      <polyline points="7 10 12 15 17 10" />
                      <line x1="12" y1="15" x2="12" y2="3" />
                    </svg>
                  </a>
                )}
              </li>
            ))}
          </ul>
        </div>
      ))}

      {archivedCount > 0 && (
        <details class="group mt-4 border-t border-slate-200">
          <summary class="flex cursor-pointer list-none items-center gap-2 py-3 text-sm font-semibold text-slate-700 hover:text-slate-900 [&::-webkit-details-marker]:hidden">
            <svg xmlns="http://www.w3.org/2000/svg" class="size-4 text-slate-600 transition-transform group-open:rotate-90" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><polyline points="9 18 15 12 9 6" /></svg>
            {en ? `Archived versions (${archivedCount})` : `Fersiynau wedi'u harchifo (${archivedCount})`}
          </summary>
          {files.archived.map((group) => (
            <div class="mb-3">
              <p class="mb-1 text-xs font-bold uppercase tracking-wider text-slate-600">
                {en ? `Version ${group.version}` : `Fersiwn ${group.version}`}
              </p>
              <ul class="divide-y divide-slate-200">
                {group.files.map((file) => (
                  <li class="flex items-center gap-3 py-2.5">
                    <div class="min-w-0 flex-1">
                      <p class="truncate text-sm text-slate-800" title={file.fileName}>{file.fileName}</p>
                      <p class="text-xs text-slate-600">{meta(file)}</p>
                    </div>
                    {file.apiLink && (
                      <a
                        href={file.apiLink}
                        class="flex size-9 shrink-0 items-center justify-center rounded-sm border border-slate-300 text-slate-700 transition-colors hover:border-slate-400 hover:bg-slate-50"
                        aria-label={`${en ? "Download" : "Lawrlwytho"} ${file.fileName}`}
                        title={en ? "Download" : "Lawrlwytho"}
                      >
                        <svg xmlns="http://www.w3.org/2000/svg" class="size-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.25" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                          <path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4" />
                          <polyline points="7 10 12 15 17 10" />
                          <line x1="12" y1="15" x2="12" y2="3" />
                        </svg>
                      </a>
                    )}
                  </li>
                ))}
              </ul>
            </div>
          ))}
        </details>
      )}
    </section>
  )
}
