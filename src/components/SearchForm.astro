---
import { Icon } from "astro-icon/components";
import type { Locale } from "../lib/i18n";
import { buildLocalizedPath } from "../lib/i18n";

interface Props {
  locale: Locale;
  query?: string;
  variant?: "hero" | "compact";
}

const { locale, query = "", variant = "compact" } = Astro.props;

const labels = {
  en: {
    input: "Search NLW Data",
    placeholder: "Search for a term, collection, or place",
    button: "Search",
  },
  cy: {
    input: "Chwilio Data LlGC",
    placeholder: "Chwiliwch am derm, casgliad, neu le",
    button: "Chwilio",
  },
};

const copy = labels[locale];
---
<form
  class="flex w-full"
  action={buildLocalizedPath(locale, "search")}
  method="get"
  role="search"
>
  <label class="sr-only" for={`search-${variant}`}>{copy.input}</label>
  <input
    id={`search-${variant}`}
    class="h-12 min-w-0 flex-1 rounded-l-sm border border-r-0 border-slate-300 bg-white px-4 text-base text-slate-900 placeholder:text-slate-500 focus-visible:z-10"
    type="search"
    name="q"
    value={query}
    placeholder={copy.placeholder}
    autocomplete="off"
  />
  <button class="flex h-12 items-center gap-2 rounded-r-sm bg-brand px-4 text-sm font-semibold text-white transition-colors hover:bg-brand-hover sm:px-6" type="submit">
    <Icon name="mdi:magnify" class="size-5" aria-hidden="true" />
    <span class="sr-only sm:not-sr-only">{copy.button}</span>
  </button>
</form>
