+/** Slugs become directory paths; encoded traversal and separators are unsafe too. */
+export function assertSafeSlug(slug: string) {
+  if (!slug || slug.startsWith("/") || slug.includes("\\")) throw new Error(`Unsafe IIIF slug: ${slug}`);
+  for (const segment of slug.split("/")) {
+    const decoded = decodeURIComponent(segment);
+    if (!decoded || decoded === "." || decoded === ".." || /[\/\\\x00-\x1f\x7f?#:]/.test(decoded)) throw new Error(`Unsafe IIIF slug: ${slug}`);
+  }
+  return slug;
+}
+export function makeGetSlugHelper(store: GenericStore, slugs: BuildConfig["slugs"]) {
+  const resolve = makeUncheckedGetSlugHelper(store, slugs);
+  return (resource: {id:string;type:string}) => {
+    const result = resolve(resource);
+    assertSafeSlug(result[0]);
